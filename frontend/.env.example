# Copiar a .env.local y completar. No se versiona.

# Backend del sitio
VITE_API_URL=http://localhost:8000/api/v1

# Ruta base, si el sitio se publica en un subdirectorio
VITE_BASE_PATH=/

# Realm de Keycloak: el issuer y el client_id del cliente público. Vacíos, /entrar recibe un
# token pegado del emisor local del backend. Funciona también por HTTP, con PKCE S256.
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_CLIENTE=
