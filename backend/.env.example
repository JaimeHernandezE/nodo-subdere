# Plantilla documentada. Copiar a .env.local o .env.prod y completar.
# Solo este archivo se versiona. Ver backend/INSTRUCCIONES.md §2.bis

# --- Ambiente ---
# El nombre de este mismo archivo. Compose lo usa para pasarle las variables
# al contenedor: --env-file solo no lo hace. Ver INSTRUCCIONES.md §2.bis
ARCHIVO_ENV=.env.local
# config.settings.local  en desarrollo
# config.settings.prod   en la producción oculta
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=cambiar-esto-en-cada-ambiente
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# 1 = agrega X-Robots-Tag: noindex a toda respuesta. En la producción oculta, 1.
NODO_OCULTO=1

# --- Base de datos (PostgreSQL en Docker Desktop) ---
# Todo en contenedores:        postgres://nodo:nodo@db:5432/nodo
# Solo Postgres en contenedor: postgres://nodo:nodo@localhost:5432/nodo
DATABASE_URL=postgres://nodo:nodo@localhost:5432/nodo
POSTGRES_DB=nodo
POSTGRES_USER=nodo
POSTGRES_PASSWORD=nodo

# --- Frontend autorizado a llamar a esta API ---
# Las cabeceras X-Procedimiento y X-Id-Tramite se permiten en el código (CORS_ALLOW_HEADERS),
# no acá: son parte del contrato, no del ambiente.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Identidad: realm de Keycloak que federa Clave Única ---
# El backend no habla con Clave Única: valida el token contra el JWKS del realm.
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_CACHE_SEGUNDOS=3600

# --- Lectura de los repositorios de servicio (app registro) ---
# Token de SOLO LECTURA. Su emisión, alcance y rotación son HR-22.
REGISTRO_GIT_API_URL=
REGISTRO_GIT_TOKEN=

# --- Adaptadores a APIs externas (app integraciones) ---
# Vacío = el adaptador se declara no disponible y responde con datos de muestra,
# diciéndolo. No inventa datos ni falla en silencio.
CUT_API_URL=
CUT_CACHE_SEGUNDOS=3600

PERMISOS_CIRCULACION_API_URL=
PERMISOS_CIRCULACION_CACHE_SEGUNDOS=300
