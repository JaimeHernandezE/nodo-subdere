# Copiar a .env y completar. .env NO se versiona.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=cambiar-esto-en-cada-ambiente
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
DATABASE_URL=postgres://nodo:nodo@localhost:5432/nodo

# --- Frontend autorizado a llamar a esta API ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Adaptadores a APIs externas (app integraciones) ---
# Vacío = el adaptador se declara no disponible y el frontend lo muestra como tal.
# No inventa datos ni falla en silencio.
CUT_API_URL=
CUT_CACHE_SEGUNDOS=3600

PERMISOS_CIRCULACION_API_URL=
PERMISOS_CIRCULACION_CACHE_SEGUNDOS=300
